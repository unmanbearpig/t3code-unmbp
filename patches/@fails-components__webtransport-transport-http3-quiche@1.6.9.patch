diff --git a/install-prebuilt.js b/install-prebuilt.js
new file mode 100644
--- /dev/null
+++ b/install-prebuilt.js
@@ -0,0 +1,46 @@
+// Normal installation is optional and prebuilt-only. Explicit upstream build
+// commands remain available to developers who deliberately compile QUICHE.
+import { spawn } from 'node:child_process'
+import { access, mkdir, rename } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import { arch, env, platform, report } from 'node:process'
+
+const targetPlatform = env.T3CODE_WEBTRANSPORT_PLATFORM || env.npm_config_platform || env.npm_config_target_platform || platform
+const targetArch = env.T3CODE_WEBTRANSPORT_ARCH || env.npm_config_arch || env.npm_config_target_arch || env.BUILDARCH || arch
+const targetLibc = env.T3CODE_WEBTRANSPORT_LIBC || env.npm_config_libc || env.LIBC ||
+  (platform === 'linux' && !report.getReport().header.glibcVersionRuntime ? 'musl' : 'glibc')
+const architectures = targetPlatform === 'darwin' && targetArch === 'universal' ? ['arm64', 'x64'] : [targetArch]
+const supported = ['darwin_x64', 'darwin_arm64', 'linux_x64', 'linux_arm64', 'win32_x64']
+
+if (architectures.some((architecture) => !supported.includes(`${targetPlatform}_${architecture}`)) ||
+    (targetPlatform === 'linux' && targetLibc !== 'glibc')) {
+  console.log('Skipping optional WebTransport prebuilt for unsupported target')
+  process.exit(0)
+}
+
+try {
+  for (const architecture of architectures) {
+    const destination = new URL(`build_${targetPlatform}_${architecture}/Release/`, import.meta.url)
+    // npm runs bundled install scripts even when the target payload is included.
+    if (await access(new URL('webtransport.node', destination)).then(() => true, () => false)) continue
+    const require = createRequire(import.meta.url)
+    const downloader = require.resolve('prebuild-install/bin.js')
+    await new Promise((resolve, reject) => {
+      const child = spawn(process.execPath, [downloader,
+        '--runtime', 'napi', '--target', '6', '--download', '--force',
+        '--platform', targetPlatform, '--arch', architecture, '--libc', targetLibc
+      ], { stdio: 'inherit', timeout: 60000 })
+      child.once('error', reject)
+      child.once('close', (code) => code === 0 ? resolve() : reject(new Error('Download failed')))
+    })
+    // The upstream archive always extracts build/Release. Put each requested
+    // binary at the loader's architecture-specific path, including universal macOS.
+    const source = new URL('build/Release/webtransport.node', import.meta.url)
+    await access(source)
+    await mkdir(destination, { recursive: true })
+    await rename(source, new URL('webtransport.node', destination))
+  }
+} catch {
+  console.error('Optional WebTransport prebuilt unavailable; WebSocket remains supported')
+  process.exit(1)
+}
